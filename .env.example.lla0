# ============================================
# LLA0 Token Deployment Configuration
# ============================================

# Network (localhost, sepolia, mainnet, bsc, polygon, etc.)
NETWORK=sepolia

# ============================================
# Deployer Configuration
# ============================================
# WARNING: Never commit your private key to git!
DEPLOYER_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ============================================
# Role Addresses
# ============================================
# IMPORTANT: Use multi-signature wallets for production!

# Default Admin - Manages all roles (recommend: 3/5 or 4/7 multisig)
DEFAULT_ADMIN_ADDR=0x0000000000000000000000000000000000000000

# Pauser - Can pause/unpause the contract (recommend: 2/3 multisig)
PAUSER_ADDR=0x0000000000000000000000000000000000000000

# Minter - Can mint tokens up to MAX_SUPPLY (recommend: 2/3 or 3/5 multisig)
MINTER_ADDR=0x0000000000000000000000000000000000000000

# ============================================
# Block Explorer API Keys (for contract verification)
# ============================================

# Etherscan (Ethereum Mainnet & Sepolia)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# BSCScan (Binance Smart Chain)
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Polygonscan (Polygon)
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ============================================
# RPC Endpoints (optional - for custom providers)
# ============================================

# Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Ethereum Mainnet
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# BSC Mainnet
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-rpc.com/

# ============================================
# Security Notes
# ============================================
# 1. Never commit .env file to version control
# 2. Use hardware wallets for deployer private key
# 3. Use multi-signature wallets for all role addresses
# 4. Keep backup of all addresses and keys in secure location
# 5. Test deployment on testnet before mainnet
